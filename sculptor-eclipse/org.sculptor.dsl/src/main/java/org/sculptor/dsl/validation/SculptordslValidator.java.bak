	@Check
	public void checkRequired(DslProperty prop) {
		if (prop.isNotChangeable() && prop.isRequired()) {
			warning("The combination not changeable and required doesn't make sense, remove required", DSL_ANY_PROPERTY__REQUIRED);
		}
	}

